<Window x:Class="YusupovMiracle.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформление заказа" Height="700" Width="1150" MinHeight="550" MinWidth="1000"
        Icon="image/icon.ico" Language="ru-RU" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Name="HeaderTB" Text="Оформление заказа" FontSize="26" Margin="0,0,0,15"/>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
            <TextBlock Text="Номер заказа" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Name="TBOrderID" Grid.Column="1" VerticalAlignment="Center"/>
            <TextBlock Text="Дата заказа" Grid.Column="2" VerticalAlignment="Center" Margin="10,0"/>
            <DatePicker Name="OrderDP" Grid.Column="3"/>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="ФИО клиента" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox Name="ClientCombo" DisplayMemberPath="FIO"/>
        </DockPanel>
        <DockPanel Grid.Row="3" Name="AddPanel" Background="#D2F6E7" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Добавить позицию" Click="AddBtn_Click"/>
            <TextBlock Text="Модель и размер" VerticalAlignment="Center" Margin="10"/>
            <ComboBox Name="PositionCombo" DisplayMemberPath="PositionText" IsEditable="True" IsTextSearchEnabled="True" Margin="5" VerticalContentAlignment="Center"/>
        </DockPanel>
        <ListView Name="ProductListView" Grid.Row="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="180"/><ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding CommodityPosition.Product.ProducPhotoPath}" Width="100" Height="100" Stretch="Uniform"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <TextBlock Text="{Binding CommodityPosition.Product.ProductName}" TextWrapping="Wrap" FontSize="20"/>
                            <TextBlock Text="{Binding CommodityPosition.Size, StringFormat=Размер: {0}}"/>
                            <TextBlock Text="{Binding CommodityPosition.QuantityInStock, StringFormat=На складе: {0}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Цена за пару"/>
                            <TextBlock Text="{Binding PriceAtOrderTime, StringFormat={}{0:N2} ₽}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="−" Width="35" Padding="0" Click="BtnMinus_Click" IsEnabled="{Binding CanChangeOrder, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <TextBlock Text="{Binding Quantity}" Width="35" TextAlignment="Center" VerticalAlignment="Center"/>
                                <Button Content="+" Width="35" Padding="0" Click="BtnPlus_Click" IsEnabled="{Binding CanChangeOrder, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                            <Button Content="Удалить позицию" Click="RemoveBtn_Click" IsEnabled="{Binding CanChangeOrder, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="Сумма"/>
                            <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:N2} ₽}" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <DockPanel Grid.Row="5" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Name="SaveBtn" Content="Сохранить заказ" Click="SaveBtn_Click"/>
            <Button DockPanel.Dock="Right" Content="Закрыть" IsCancel="True"/>
            <TextBlock Name="TotalTB" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
