<Page x:Class="YusupovMiracle.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Список заказов" Loaded="Page_Loaded">
    <Grid Margin="15">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Список заказов" FontSize="26" Margin="5,0,0,15"/>
        <DataGrid Grid.Row="1" Name="OrdersGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" CanUserDeleteRows="False" Background="White" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" Binding="{Binding OrderID}" Width="90"/>
                <DataGridTextColumn Header="Дата заказа" Binding="{Binding OrderDate, StringFormat=dd.MM.yyyy}" Width="160"/>
                <DataGridTextColumn Header="ФИО клиента" Binding="{Binding Client.FIO}" Width="*"/>
                <DataGridTextColumn Header="Пар обуви" Binding="{Binding TotalCount}" Width="130"/>
                <DataGridTextColumn Header="Итоговая сумма, ₽" Binding="{Binding TotalPrice, StringFormat=N2}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Состав заказа" Click="ViewBtn_Click"/>
            <Button Content="Добавить заказ" Click="AddBtn_Click"/>
            <Button Name="EditBtn" Content="Редактировать" Click="EditBtn_Click"/>
            <Button Content="Удалить заказ" Click="DeleteBtn_Click"/>
        </WrapPanel>
    </Grid>
</Page>
