<Window x:Class="YusupovMiracle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь — Юсупов" Height="800" Width="1400" MinHeight="650" MinWidth="1050"
        FontFamily="Calibri" Icon="image/icon.ico" Language="ru-RU" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#D2F6E7"/>
        <Image Source="/image/logo.png" HorizontalAlignment="Left" Width="140" Margin="15,5" Stretch="Uniform"/>
        <TextBlock Text="Чудо Обувь" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Frame Grid.Row="1" Name="MainFrame" ContentRendered="MainFrame_ContentRendered" NavigationUIVisibility="Hidden"/>
        <Button Content="Назад" Name="BtnBack" HorizontalAlignment="Right" VerticalAlignment="Center" Width="130" Click="BtnBack_Click"/>
    </Grid>
</Window>